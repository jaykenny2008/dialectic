{
  "manifest_version": 3,
  "name": "Phone Gamepad",
  "version": "1.0.0",
  "description": "Makes the iPhone controller show up as a real gamepad (analog sticks) in browser games.",
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["gamepad.js"],
      "run_at": "document_start",
      "all_frames": true,
      "match_about_blank": true,
      "world": "MAIN"
    },
    {
      "matches": ["<all_urls>"],
      "js": ["bridge.js"],
      "run_at": "document_start",
      "all_frames": true,
      "match_about_blank": true
    }
  ]
}
